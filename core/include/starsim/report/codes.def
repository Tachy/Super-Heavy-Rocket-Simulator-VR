// Report code list: STARSIM_CODE(enumerator, "dotted.id", "param1,param2").
// The enumerator is the id with '.' replaced by '_'. Parameter names are lowercase snake case.
// Every entry needs a text under [report] in config/i18n/de.toml and en.toml (python tools/i18n_check.py codes).

// general
STARSIM_CODE(ok, "ok", "")
STARSIM_CODE(legacy, "legacy", "text")

// command
STARSIM_CODE(command_internal_error, "command.internal_error", "")

// iss: ISS mission legs and their outcomes
STARSIM_CODE(iss_leg, "iss.leg", "leg")
STARSIM_CODE(iss_leg_status, "iss.leg_status", "leg,cause")
STARSIM_CODE(iss_undock_planned, "iss.undock_planned", "")
STARSIM_CODE(iss_proximity_retry, "iss.proximity_retry", "retry")
STARSIM_CODE(iss_departure_planning_return, "iss.departure_planning_return", "")
STARSIM_CODE(iss_return_planned, "iss.return_planned", "")
STARSIM_CODE(iss_continued, "iss.continued", "")
STARSIM_CODE(iss_completed, "iss.completed", "cause")
STARSIM_CODE(iss_ended, "iss.ended", "cause")
STARSIM_CODE(iss_reason_depot_in_orbit, "iss.reason_depot_in_orbit", "")
STARSIM_CODE(iss_reason_docked, "iss.reason_docked", "port")
STARSIM_CODE(iss_reason_departed, "iss.reason_departed", "")
STARSIM_CODE(iss_reason_caught, "iss.reason_caught", "")
STARSIM_CODE(iss_reason_splashed_down, "iss.reason_splashed_down", "")
STARSIM_CODE(iss_raise_not_possible, "iss.raise_not_possible", "")
STARSIM_CODE(iss_docking_failed_after_retries, "iss.docking_failed_after_retries", "retries")
STARSIM_CODE(iss_collision, "iss.collision", "")
STARSIM_CODE(iss_vehicle_lost, "iss.vehicle_lost", "")
STARSIM_CODE(iss_return_not_possible, "iss.return_not_possible", "")
STARSIM_CODE(iss_return_aborted, "iss.return_aborted", "")
STARSIM_CODE(iss_ship_lost, "iss.ship_lost", "")
STARSIM_CODE(iss_ship_not_caught, "iss.ship_not_caught", "")
STARSIM_CODE(iss_capsule_lost, "iss.capsule_lost", "")

// reboost: station keeping of the depot
STARSIM_CODE(reboost_flying, "reboost.flying", "")
STARSIM_CODE(reboost_completed, "reboost.completed", "")
STARSIM_CODE(reboost_already_running, "reboost.already_running", "")
STARSIM_CODE(reboost_no_station, "reboost.no_station", "")
STARSIM_CODE(reboost_other_vehicles, "reboost.other_vehicles", "")
STARSIM_CODE(reboost_no_engine_groups, "reboost.no_engine_groups", "")
STARSIM_CODE(reboost_height_sufficient, "reboost.height_sufficient", "")
STARSIM_CODE(reboost_aborted, "reboost.aborted", "cause")
STARSIM_CODE(reboost_burn_not_possible, "reboost.burn_not_possible", "")

// station: ISS start state notes
STARSIM_CODE(station_oem_source, "station.oem_source", "date")
STARSIM_CODE(station_oem_source_assumed, "station.oem_source_assumed", "date,maneuvers")
STARSIM_CODE(station_synthetic_from_oem, "station.synthetic_from_oem", "date")
STARSIM_CODE(station_synthetic_from_config, "station.synthetic_from_config", "")
STARSIM_CODE(station_no_oem, "station.no_oem", "cause")
STARSIM_CODE(station_reboost_maneuver, "station.reboost_maneuver", "utc,dv,name")
